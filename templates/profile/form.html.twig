{% extends 'base.html.twig' %}

{% block title %}Créer un profil{% endblock %}

{% block body %}
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 mb-4">Créer un profil</h1>

            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="mb-3">
                    {{ form_row(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.seriousRelationship) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.birthdate) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.email) }}
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Envoyer</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
