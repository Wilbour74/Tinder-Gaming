{% extends 'base.html.twig' %}
{% block title %}Citation aléatoire{% endblock %}
{% block body %}
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <p class="text-uppercase text-secondary small fw-semibold mb-2">Une pensée au hasard</p>
            <h1 class="h2 mb-4">Citation aléatoire</h1>
            <blockquote class="blockquote mb-0">
                <p class="fs-4">« {{ quote }} »</p>
            </blockquote>
        </div>
    </div>
{% endblock %}