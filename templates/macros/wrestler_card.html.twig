{% macro wrestler_card(wrestler) %}
<div class="col-12 col-md-6 col-xl-4">
    <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between gap-3 mb-3">
                <h2 class="h1 mb-0">{{ wrestler.name|fullCapitalize }}</h2>
                <h3 class="h5 mb-0">{{ wrestler.name|replace({' ': '-'})|lower}}</h3>
                {% if wrestler.champion %}
                    <span class="badge text-bg-warning align-self-start">Champion</span>
                {% else %}
                    <span class="badge text-bg-light border align-self-start">Non champion</span>
                {% endif %}
            </div>
            <div class="d-flex gap-3 text-secondary small">
                <span>{{ wrestler.age }} ans</span>
                <span>{{ wrestler.poids }} kg</span>
            </div>
        </div>
    </div>
</div>
{% endmacro %}